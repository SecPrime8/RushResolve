# PowerShell 5.1 on Windows: keep CRLF in the working tree.
# Without this, importing CRLF files against LF-stored blobs renders as a
# whole-file rewrite (8063 lines vs the real 529-line change).
* text=auto eol=crlf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.md   text eol=crlf
*.json text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.msi binary
*.msix binary
*.msixbundle binary
*.appx binary
